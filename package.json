{
  "name": "lab-engenharia-software-view",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "dev:web": "node scripts/dev-server.mjs",
    "build": "ng build",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "oxlint --type-aware view/ && eslint .",
    "lint:ts": "oxlint --type-aware view/",
    "lint:angular": "eslint .",
    "lint:fix": "oxlint --type-aware --fix view/ && eslint . --fix",
    "lint:angular:fix": "eslint . --fix",
    "format": "oxfmt --write \"view/**/*.{ts,html,css,scss,json}\" *.mjs scripts/*.mjs",
    "format:check": "oxfmt --check \"view/**/*.{ts,html,css,scss,json}\" *.mjs scripts/*.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.13.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.88.0",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "^7.8.2"
  }
}
