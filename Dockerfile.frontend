# Dockerfile.frontend
FROM node:22-bookworm-slim AS dev

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY angular.json tsconfig.json* vitest.config.ts* ./
COPY scripts ./scripts
COPY view ./view

EXPOSE 4200

ENV API_PROXY_TARGET=http://backend:8000

CMD ["npm", "run", "dev:web"]

FROM dev AS build
RUN npm run build

FROM nginx:alpine AS prod
COPY --from=build /app/view/dist/web/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
