# Spotify Web API Credentials (Optional - Development Mode)
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:4200/callback
# SPOTIFY_REFRESH_TOKEN=

# Google Cloud Storage (Optional - Catalog Tracks Parquet)
# GCS_BUCKET_NAME=your_gcs_bucket_name_here
# GCS_TRACKS_FILE_PATH=Songs/tracks.parquet

# Firestore synchronization (required when ENVIRONMENT=production)
FIRESTORE_ENABLED=false
GCP_PROJECT_ID=your_gcp_project_id
FIRESTORE_DATABASE=(default)

# Path to GCP service account JSON key file (optional if using gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Local Emulation (Optional - Docker fake-gcs-server)
# STORAGE_EMULATOR_HOST=http://localhost:4443

# Google Identity Services (Optional - OAuth 2.0 Web Client ID)
# GOOGLE_CLIENT_ID=your_google_client_id_here
# Optional OAuth Client Secret or JSON path (for Authorization Code Flow)
# GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback
